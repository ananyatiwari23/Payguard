# Optional OpenAI-compatible model configuration.
# Leave OPENAI_API_KEY empty to use the deterministic local fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=
GPT_OSS_120B_MODEL=gpt-oss-120b
GPT_OSS_SAFEGUARD_120B_MODEL=gpt-oss-safeguard-120b
LLM_TIMEOUT=6.0

# CORS Origins (comma-separated, default is * for development)
CORS_ORIGINS=*
